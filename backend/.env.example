# Configurações do Django
SECRET_KEY=sua-chave-secreta-django-aqui
DEBUG=True

# Conexão PostgreSQL (Supabase)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_do_supabase_aqui
DB_HOST=seu-host-do-supabase.supabase.co
DB_PORT=5432

# Opcional (padrao: require) - exigido pelo Supabase para conexao segura
DB_SSLMODE=require